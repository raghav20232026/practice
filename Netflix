function generateQR(){
  // Generate a visual QR-like pattern using SVG
  let squares = '';
  const seed = Math.random();
  for(let i=0;i<7;i++){
    for(let j=0;j<7;j++){
      const fill = (Math.sin(i*j+seed*10+i+j)>0)||((i<3||i>3)&&(j<3||j>3)) ? '#fff' : 'transparent';
      squares += `<rect x="${j*20}" y="${i*20}" width="19" height="19" fill="${fill}" rx="2"/>`;
    }
  }
  // Corner marks
  const cm = `<rect x="1" y="1" width="55" height="55" fill="none" stroke="#fff" stroke-width="5" rx="5"/>
  <rect x="84" y="1" width="55" height="55" fill="none" stroke="#fff" stroke-width="5" rx="5"/>
  <rect x="1" y="84" width="55" height="55" fill="none" stroke="#fff" stroke-width="5" rx="5"/>`;
  return `<svg viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg">
    <rect width="140" height="140" fill="transparent"/>
    ${squares}${cm}
    <rect x="15" y="15" width="27" height="27" fill="#fff" rx="3"/>
    <rect x="98" y="15" width="27" height="27" fill="#fff" rx="3"/>
    <rect x="15" y="98" width="27" height="27" fill="#fff" rx="3"/>
    <rect x="60" y="60" width="20" height="20" fill="#fff" rx="3"/>
  </svg>`;
}

