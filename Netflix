function detectMyLocation(){
  const btn=document.getElementById('detectLocBtn');
  btn.textContent='🔄 Detecting...';btn.disabled=true;
  navigator.geolocation.getCurrentPosition(
    pos=>{
      myLat=pos.coords.latitude;myLng=pos.coords.longitude;
      const cities={goa:{lat:15.49,lng:73.82,name:'Goa'},delhi:{lat:28.61,lng:77.20,name:'Delhi'},mumbai:{lat:19.07,lng:72.87,name:'Mumbai'},jaipur:{lat:26.91,lng:75.78,name:'Jaipur'},manali:{lat:32.24,lng:77.18,name:'Manali'},varanasi:{lat:25.32,lng:82.97,name:'Varanasi'},lucknow:{lat:26.85,lng:80.94,name:'Lucknow'},agra:{lat:27.17,lng:78.01,name:'Agra'},shimla:{lat:31.10,lng:77.17,name:'Shimla'},kerala:{lat:9.93,lng:76.26,name:'Kerala'}};
      let nearest='varanasi',minD=999;
      Object.entries(cities).forEach(([k,v])=>{
        const d=Math.sqrt((myLat-v.lat)**2+(myLng-v.lng)**2);
        if(d<minD){minD=d;nearest=k;myCity=v.name;}
      });
      document.getElementById('locStatusText').textContent=`📍 Location detected: Near ${myCity} (${myLat.toFixed(2)}°N, ${myLng.toFixed(2)}°E)`;
      btn.textContent='✅ Located!';
      showNearby(nearest);
    },
    ()=>{
      const d=DEST_DATA['varanasi'];myCity='Varanasi';
      document.getElementById('locStatusText').textContent='📍 Default: Varanasi area (GPS not available)';
      btn.textContent='📍 Default Location';btn.disabled=false;
      showNearby('varanasi');
    }
  );
}
