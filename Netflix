function closeRestModal(){document.getElementById('restModal').classList.add('hidden');}

function buildMenuSection(secId,items,isVeg){
  const sec=document.getElementById(secId);
  sec.innerHTML=items.map((item,idx)=>`<div class="menu-item" id="mi_${secId}_${idx}">
    <img class="mi-img" src="${item.img}" alt="${item.n}" onerror="this.style.background='#f0f4ff';this.src=''">
    <div class="mi-info">
      <div class="mi-name">${isVeg?`<span class="veg-dot"></span>`:`<span class="nonveg-dot"></span>`} ${item.n}</div>
      <div class="mi-desc">${item.d} • ${item.cal}</div>
      <div class="mi-price">₹${item.p}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
      <div class="qty-ctrl">
        <button class="qty-btn" onclick="changeQty('${secId}_${idx}','${item.n}',${item.p},-1)">−</button>
        <span class="qty-val" id="qv_${secId}_${idx}">0</span>
        <button class="qty-btn" onclick="changeQty('${secId}_${idx}','${item.n}',${item.p},1)">+</button>
      </div>
      <button style="background:#fff7ed;color:#c2410c;border:1px solid #fdba74;border-radius:6px;padding:3px 8px;font-size:10px;cursor:pointer;font-weight:700;" onclick="showRecipe('${item.recipe||'default'}')">📖 Recipe</button>
    </div>
  </div>`).join('');
}

function changeQty(id,name,price,delta){
  if(!cartItems[id])cartItems[id]={name,price,qty:0};
  cartItems[id].qty=Math.max(0,cartItems[id].qty+delta);
  const el=document.getElementById('qv_'+id);
  if(el)el.textContent=cartItems[id].qty;
  updateTotal();
}

function updateTotal(){
  let total=0;
  Object.values(cartItems).forEach(i=>total+=i.price*i.qty);
  const r=currentRestaurant;
  let disc=0;
  if(r&&r.offerVal&&total>0)disc=Math.round(total*r.offerVal/100);
  const final=total-disc;
  document.getElementById('modalTotal').textContent='₹'+final.toLocaleString();
  const ol=document.getElementById('offerLine');
  if(disc>0){ol.style.display='block';ol.textContent=`🎉 Offer applied! You saved ₹${disc}`;}
  else ol.style.display='none';
}

function switchTab(tab){
  const tabs=['veg','nonveg','review','table'];
  tabs.forEach(t=>{
    document.getElementById(t+'Section').classList.add('hidden');
    const btn=document.getElementById(t+'Tab');
    if(btn){btn.classList.remove('veg-active','nonveg-active');btn.style.background='#f8faff';btn.style.color='var(--muted)';}
  });
  document.getElementById(tab+'Section').classList.remove('hidden');
  const activeBtn=document.getElementById(tab+'Tab');
  if(activeBtn){
    if(tab==='veg'){activeBtn.classList.add('veg-active');}
    else if(tab==='nonveg'){activeBtn.classList.add('nonveg-active');}
    else{activeBtn.style.background='var(--primary)';activeBtn.style.color='#fff';}
  }
}

