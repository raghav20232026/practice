/* ═══ VOICE ═══════════════════════════════════════════ */
let isListening=false;
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
let recognition=SR?new SR():null;
if(recognition){recognition.lang='hi-IN';recognition.continuous=false;recognition.interimResults=false;
  recognition.onresult=e=>{
    const t=e.results[0][0].transcript.toLowerCase();
    stopListening();handleVoice(t);
  };
  recognition.onerror=()=>stopListening();
  recognition.onend=()=>stopListening();
}
function toggleVoice(){isListening?stopListening():startListening();}
function startListening(){
  if(!recognition){showChat('Voice support nahi hai is browser mein.');return;}
  isListening=true;
  document.getElementById('micBtn').classList.add('listening');
  document.getElementById('voiceLabel').textContent='🔴 Bol raha hoon...';
  document.getElementById('langBadge').style.display='block';
  recognition.start();
}
function stopListening(){
  isListening=false;
  document.getElementById('micBtn').classList.remove('listening');
  document.getElementById('voiceLabel').textContent='🎤 Tap to talk';
  if(recognition){try{recognition.stop();}catch(e){}}
}
function handleVoice(text){
  const dest=Object.keys(DEST_DATA).find(k=>text.includes(k));
  if(dest){
    document.getElementById('destination').value=dest.charAt(0).toUpperCase()+dest.slice(1);
    showChat(`🎤 "${text}"\n✈️ ${dest.charAt(0).toUpperCase()+dest.slice(1)} detect hua! Plan kar raha hoon...`);
    setTimeout(planTrip,1200);
  } else if(text.includes('hotel')||text.includes('stay')){
    showChat(`🏨 Hotel dhundh raha hoon!\n"${text}"`);
  } else if(text.includes('restaurant')||text.includes('khana')||text.includes('food')){
    showChat(`🍽️ Restaurant dhundh raha hoon!\n"${text}"`);
  } else if(text.includes('gym')||text.includes('fitness')||text.includes('workout')){
    showChat(`💪 Nearby gyms dhundh raha hoon!\n"${text}"`);
  } else if(text.includes('payment')||text.includes('pay')){
    showChat(`💳 Payment options dikha raha hoon!`);
    setTimeout(()=>openPaymentPopup('upi'),1000);
  } else {
    showChat(`🎤 Suna: "${text}"\n\nKeh sakte hain:\n"Goa trip plan karo"\n"Delhi hotel chahiye"\n"Jaipur restaurants"\n"Gym dhundo"`);
  }
}
function showChat(msg){
  const b=document.getElementById('chatBubble');
  b.textContent=msg;b.classList.add('show');
  setTimeout(()=>b.classList.remove('show'),5000);
}

