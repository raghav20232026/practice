/* ═══ RESTAURANT MODAL ═══════════════════════════════════ */
function openRestModal(cityKey, r){
  if(typeof r==='string'){
    const d=DEST_DATA[cityKey];
    r=d&&d.restaurants.find(x=>x.name===r);
    if(!r)return;
  }
  currentRestaurant={...r,city:cityKey};
  cartItems={};
  document.getElementById('restModalTitle').textContent='🍽️ '+r.name;
  document.getElementById('restModal').classList.remove('hidden');
  document.getElementById('restOffer').innerHTML=r.offer?`<div class="offer-strip">🎁 ${r.offer}</div>`:'';
  const menu=MENUS[cityKey]||MENUS.default;
