<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Smart Trip Planner</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --primary:#1a56db;--accent:#8b5cf6;--success:#059669;--danger:#dc2626;
  --orange:#f97316;--bg:#f0f4ff;--card:#fff;--text:#1e293b;--muted:#64748b;
  --border:#e2e8f0;--gold:#f59e0b;--veg:#16a34a;--nonveg:#dc2626;
}
body{font-family:'Poppins',sans-serif;background:var(--bg);min-height:100vh;padding:16px;}
.container{max-width:1120px;margin:auto;}
.hero{background:linear-gradient(135deg,#0f2460,#1a56db,#8b5cf6);border-radius:24px;padding:28px 32px;text-align:center;margin-bottom:20px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");}
.hero h1{font-family:'Baloo 2';font-size:2.2rem;font-weight:800;color:#fff;position:relative;}
.hero p{color:rgba(255,255,255,.8);font-size:.9rem;margin-top:4px;position:relative;}
.card{background:var(--card);padding:22px;border-radius:20px;box-shadow:0 4px 24px rgba(0,0,0,.08);margin-bottom:18px;border:1px solid var(--border);}
.sec-title{font-family:'Baloo 2';font-size:1.35rem;font-weight:700;color:var(--text);margin:18px 0 10px;display:flex;align-items:center;gap:8px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:600px){.form-grid{grid-template-columns:1fr;}}
.fg label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:5px;}
.fg input,.fg select{width:100%;padding:11px 14px;border-radius:11px;border:1.5px solid var(--border);font-size:14px;font-family:'Poppins';background:#f8faff;transition:.2s;color:var(--text);}
.fg input:focus,.fg select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(26,86,219,.1);background:#fff;}
.btn{padding:11px 24px;border-radius:11px;font-weight:700;cursor:pointer;border:none;font-size:14px;font-family:'Poppins';transition:.2s;display:inline-flex;align-items:center;gap:6px;}
.btn-primary{background:linear-gradient(135deg,#1a56db,#8b5cf6);color:#fff;width:100%;justify-content:center;margin-top:8px;}
.btn-primary:hover{opacity:.9;transform:translateY(-1px);}
.btn-success{background:linear-gradient(135deg,#059669,#34d399);color:#fff;}
.btn-orange{background:linear-gradient(135deg,#f97316,#fbbf24);color:#fff;}
.btn-sm{padding:7px 14px;font-size:12px;border-radius:8px;}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:700px){.grid-2{grid-template-columns:1fr;}}
.place-card{background:var(--card);border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.09);border:2px solid transparent;transition:.3s;position:relative;}
.place-card:hover{transform:translateY(-4px);box-shadow:0 10px 28px rgba(0,0,0,.14);border-color:var(--primary);}
.place-card.selected{border-color:var(--success);box-shadow:0 0 0 4px rgba(5,150,105,.15);}
.place-card img{width:100%;height:160px;object-fit:cover;}
.place-card .cb{padding:12px;}
.place-card .cn{font-weight:700;font-size:14px;color:var(--text);}
.stars{color:var(--gold);font-size:13px;}
.price-tag{font-size:13px;font-weight:700;color:var(--primary);}
.badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;}
.b-orange{background:#fff7ed;color:#c2410c;}
.b-blue{background:#eff6ff;color:#1d4ed8;}
.b-green{background:#f0fdf4;color:#166534;}
.offer-strip{background:linear-gradient(135deg,#fef3c7,#fde68a);border:1.5px solid #f59e0b;border-radius:10px;padding:8px 12px;margin:8px 0;display:flex;align-items:center;gap:8px;font-size:12px;color:#92400e;font-weight:600;}
.day-card{background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:1.5px solid #bae6fd;border-radius:14px;padding:14px 16px;margin-bottom:10px;}
.day-title{font-size:.95rem;font-weight:800;color:#0369a1;margin-bottom:8px;}
.day-item{display:flex;align-items:flex-start;gap:8px;margin:5px 0;font-size:13px;color:#334155;line-height:1.5;}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;display:flex;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto;}
.modal{background:#fff;border-radius:22px;width:100%;max-width:680px;margin:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);overflow:hidden;}
.modal-header{background:linear-gradient(135deg,#0f2460,#1a56db);padding:18px 22px;color:#fff;display:flex;justify-content:space-between;align-items:center;}
.modal-header h2{font-family:'Baloo 2';font-size:1.3rem;}
.close-btn{background:rgba(255,255,255,.2);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;}
.modal-body{padding:18px 22px;max-height:80vh;overflow-y:auto;}
.tabs{display:flex;gap:0;margin-bottom:16px;border-radius:12px;overflow:hidden;border:1.5px solid var(--border);}
.tab-btn{flex:1;padding:10px;border:none;cursor:pointer;font-family:'Poppins';font-size:13px;font-weight:700;transition:.2s;background:#f8faff;color:var(--muted);}
.tab-btn.veg-active{background:var(--veg);color:#fff;}
.tab-btn.nonveg-active{background:var(--nonveg);color:#fff;}
.veg-dot{width:12px;height:12px;border-radius:2px;border:1.5px solid var(--veg);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
.veg-dot::after{content:'';width:6px;height:6px;background:var(--veg);border-radius:50%;}
.nonveg-dot{width:12px;height:12px;border-radius:2px;border:1.5px solid var(--nonveg);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
.nonveg-dot::after{content:'';width:6px;height:6px;background:var(--nonveg);border-radius:50%;}
.menu-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);cursor:pointer;transition:.15s;}
.menu-item:last-child{border-bottom:none;}
.menu-item:hover{background:#f8faff;border-radius:10px;padding:10px 8px;}
.mi-img{width:60px;height:60px;border-radius:10px;object-fit:cover;flex-shrink:0;}
.mi-info{flex:1;min-width:0;}
.mi-name{font-weight:600;font-size:13px;color:var(--text);display:flex;align-items:center;gap:6px;}
.mi-desc{font-size:11px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mi-price{font-weight:700;font-size:14px;color:var(--primary);}
.qty-ctrl{display:flex;align-items:center;gap:6px;}
.qty-btn{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--primary);background:#fff;color:var(--primary);font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:800;transition:.15s;}
.qty-btn:hover{background:var(--primary);color:#fff;}
.qty-val{font-weight:700;font-size:14px;min-width:18px;text-align:center;}
.table-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:10px 0;}
.table-btn{padding:10px 0;border-radius:10px;border:2px solid var(--border);background:#f8faff;cursor:pointer;font-size:12px;font-weight:700;color:var(--muted);text-align:center;transition:.2s;}
.table-btn:hover{border-color:var(--primary);color:var(--primary);}
.table-btn.occupied{background:#fee2e2;border-color:#fca5a5;color:#dc2626;cursor:not-allowed;}
.table-btn.selected-table{background:var(--success);border-color:var(--success);color:#fff;}
.recipe-popup{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:3000;display:flex;align-items:center;justify-content:center;padding:16px;}
.recipe-box{background:#fff;border-radius:20px;max-width:480px;width:100%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.recipe-box .rh{background:linear-gradient(135deg,#f97316,#fbbf24);padding:16px 20px;display:flex;justify-content:space-between;align-items:center;border-radius:20px 20px 0 0;}
.recipe-box .rh h3{font-family:'Baloo 2';font-size:1.2rem;color:#fff;}
.recipe-box .rb{padding:18px 20px;}
.recipe-step{display:flex;gap:10px;margin:8px 0;font-size:13px;color:var(--text);align-items:flex-start;}
.step-num{background:var(--primary);color:#fff;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0;}
.loc-popup{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:3000;display:flex;align-items:center;justify-content:center;padding:16px;}
.loc-box{background:#fff;border-radius:20px;max-width:500px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.loc-box .lh{background:linear-gradient(135deg,#059669,#34d399);padding:14px 20px;display:flex;justify-content:space-between;align-items:center;}
.loc-box .lh h3{font-family:'Baloo 2';font-size:1.1rem;color:#fff;}
.map-frame{width:100%;height:300px;border:none;}
.review-section{margin-top:12px;}
.review-item{background:#f8faff;border-radius:12px;padding:10px 14px;margin-bottom:8px;}
.review-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
.reviewer{font-weight:700;font-size:13px;color:var(--text);}
.review-text{font-size:12px;color:var(--muted);line-height:1.5;}
.add-review{margin-top:10px;}
.add-review textarea{width:100%;padding:10px;border-radius:10px;border:1.5px solid var(--border);font-family:'Poppins';font-size:13px;resize:none;}
.star-select{display:flex;gap:4px;margin:6px 0;}
.star-select span{font-size:22px;cursor:pointer;transition:.1s;opacity:.4;}
.star-select span.active{opacity:1;}
.receipt-card{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;border-radius:18px;padding:20px;margin-top:16px;}
.r-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed #a7f3d0;font-size:13px;}
.r-row:last-child{border:none;font-size:15px;font-weight:800;color:var(--success);margin-top:4px;}
#voicePanel{position:fixed;bottom:20px;right:20px;z-index:999;display:flex;flex-direction:column;align-items:flex-end;gap:8px;}
#chatBubble{background:linear-gradient(135deg,#0f2460,#4c1d95);color:#fff;border-radius:16px 16px 4px 16px;padding:12px 14px;max-width:270px;font-size:12.5px;line-height:1.6;box-shadow:0 8px 28px rgba(79,70,229,.4);display:none;word-break:break-word;white-space:pre-line;}
#chatBubble.show{display:block;animation:popIn .2s ease;}
@keyframes popIn{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}
#micBtn{width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;background:linear-gradient(135deg,#1a56db,#8b5cf6);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 22px rgba(124,58,237,.5);transition:.2s;position:relative;flex-shrink:0;}
#micBtn:hover{transform:scale(1.1);}
#micBtn svg{width:24px;height:24px;fill:white;pointer-events:none;}
#micBtn.listening::before{content:'';position:absolute;inset:-8px;border-radius:50%;border:3px solid #8b5cf6;animation:ring 1s infinite;}
#micBtn.listening::after{content:'';position:absolute;inset:-16px;border-radius:50%;border:2px solid rgba(139,92,246,.3);animation:ring 1s .4s infinite;}
@keyframes ring{0%{transform:scale(1);opacity:1}100%{transform:scale(1.6);opacity:0}}
#voiceLabel{font-size:10px;color:#64748b;text-align:center;}
#langBadge{background:#fff;border-radius:20px;padding:4px 10px;font-size:10px;font-weight:700;color:var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.1);display:none;}
.hidden{display:none !important;}
#homePage{display:block;}
#mainApp{display:none;}
#mainApp:not(.hidden){display:block;}
.tag{display:inline-block;background:#eff6ff;color:#1d4ed8;border-radius:7px;padding:3px 9px;font-size:11px;font-weight:600;margin:2px;}
.hotel-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:2500;display:flex;align-items:flex-start;justify-content:center;overflow-y:auto;padding:12px;}
.hotel-modal{background:#fff;border-radius:22px;width:100%;max-width:780px;margin:auto;overflow:hidden;box-shadow:0 24px 70px rgba(0,0,0,.3);}
.hm-gallery{position:relative;height:280px;overflow:hidden;}
.hm-gallery img.hm-main{width:100%;height:280px;object-fit:cover;transition:.4s;}
.hm-thumbs{display:flex;gap:8px;padding:10px 16px;background:#0f1c3a;overflow-x:auto;}
.hm-thumb{width:70px;height:52px;border-radius:8px;object-fit:cover;cursor:pointer;border:2px solid transparent;flex-shrink:0;transition:.2s;opacity:.7;}
.hm-thumb:hover,.hm-thumb.active{border-color:#fff;opacity:1;}
.hm-body{padding:20px 22px;}
.hm-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;margin-bottom:14px;}
.hm-name{font-family:'Baloo 2';font-size:1.6rem;font-weight:800;color:var(--text);}
.hm-price-box{text-align:right;}
.hm-price{font-size:1.4rem;font-weight:800;color:var(--primary);}
.facility-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin:14px 0;}
.facility-item{display:flex;align-items:center;gap:8px;background:#f8faff;border-radius:10px;padding:10px 12px;font-size:12px;font-weight:600;color:var(--text);}
.facility-item .fi{font-size:20px;flex-shrink:0;}
.room-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin:12px 0;}
.room-card{border:1.5px solid var(--border);border-radius:14px;overflow:hidden;cursor:pointer;transition:.2s;}
.room-card:hover{border-color:var(--primary);box-shadow:0 4px 16px rgba(26,86,219,.15);}
.room-card.selected-room{border-color:var(--success);background:#f0fdf4;}
.room-card img{width:100%;height:120px;object-fit:cover;}
.room-card .rc-body{padding:10px 12px;}
.room-card .rc-name{font-weight:700;font-size:13px;color:var(--text);}
.room-card .rc-feat{font-size:11px;color:var(--muted);margin:3px 0;}
.room-card .rc-price{font-weight:800;color:var(--primary);font-size:14px;}
.hm-tabs{display:flex;border-bottom:2px solid var(--border);margin-bottom:14px;overflow-x:auto;}
.hm-tab{padding:10px 18px;border:none;background:none;cursor:pointer;font-family:'Poppins';font-size:13px;font-weight:600;color:var(--muted);border-bottom:3px solid transparent;margin-bottom:-2px;white-space:nowrap;}
.hm-tab.active{color:var(--primary);border-bottom-color:var(--primary);}

/* ── FOOTER ── */
.site-footer{background:linear-gradient(135deg,#0f172a,#1e293b);color:#94a3b8;margin-top:40px;border-radius:24px 24px 0 0;}
.footer-top{padding:36px 32px 28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px;}
.footer-col h4{color:#fff;font-weight:700;font-size:14px;margin-bottom:12px;font-family:'Baloo 2';}
.footer-col a{display:block;color:#94a3b8;font-size:13px;margin:6px 0;text-decoration:none;transition:.15s;cursor:pointer;}
.footer-col a:hover{color:#e2e8f0;}
.footer-award{background:linear-gradient(135deg,#1d4ed8,#7c3aed);border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:12px;margin-top:10px;}
.footer-award .aw-icon{font-size:2rem;}
.footer-award .aw-text{font-size:11px;color:#e0e7ff;line-height:1.5;}
.footer-award .aw-title{font-weight:800;font-size:13px;color:#fff;}
.footer-pay{padding:18px 32px;border-top:1px solid #1e293b;display:flex;flex-wrap:wrap;gap:10px;align-items:center;}
.pay-badge{background:#1e293b;border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;color:#94a3b8;border:1px solid #334155;cursor:pointer;transition:.15s;}
.pay-badge:hover{background:#334155;color:#fff;}
.footer-bottom{padding:16px 32px;border-top:1px solid #1e293b;display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;font-size:12px;}
.footer-bottom a{color:#64748b;text-decoration:none;}
.footer-bottom a:hover{color:#94a3b8;}
@media(max-width:600px){.footer-top{padding:24px 20px;}.footer-pay,.footer-bottom{padding:14px 20px;}}

/* ── GENERIC POPUP ── */
.gen-popup{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:4000;display:flex;align-items:center;justify-content:center;padding:16px;}
.gen-box{background:#fff;border-radius:22px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 70px rgba(0,0,0,.35);}
.gen-head{padding:18px 22px;display:flex;justify-content:space-between;align-items:center;border-radius:22px 22px 0 0;}
.gen-body{padding:20px 22px;}

/* ── PAYMENT POPUP ── */
.pay-option{display:flex;align-items:center;gap:14px;padding:14px;border:1.5px solid var(--border);border-radius:14px;margin-bottom:10px;cursor:pointer;transition:.2s;}
.pay-option:hover{border-color:var(--primary);background:#f0f4ff;}
.pay-option .pi{font-size:2rem;width:48px;text-align:center;}
.pay-option .pt{font-weight:700;font-size:14px;color:var(--text);}
.pay-option .ps{font-size:12px;color:var(--muted);}
.qr-box{background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:2px solid #bae6fd;border-radius:16px;padding:20px;text-align:center;margin:12px 0;}
.qr-img{width:160px;height:160px;background:linear-gradient(135deg,#1a56db,#8b5cf6);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;position:relative;overflow:hidden;}
.qr-img svg{width:140px;height:140px;}

/* ── GYM CARD ── */
.gym-card{background:linear-gradient(135deg,#fff7ed,#fef3c7);border:1.5px solid #fcd34d;border-radius:14px;padding:14px;margin-bottom:10px;display:flex;gap:14px;align-items:flex-start;}
.gym-icon{font-size:2.2rem;flex-shrink:0;}
.gym-name{font-weight:800;font-size:14px;color:#92400e;}
.gym-meta{font-size:12px;color:#b45309;margin-top:3px;}
.gym-badge{display:inline-block;background:#fef08a;color:#78350f;border-radius:20px;padding:2px 10px;font-size:10px;font-weight:700;margin-top:4px;}

/* ── FAMOUS PLACES ── */
.famous-place{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;}
.famous-place:last-child{border-bottom:none;}
.fp-num{width:28px;height:28px;background:linear-gradient(135deg,#1a56db,#8b5cf6);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0;}
.fp-info{flex:1;}
.fp-name{font-weight:700;color:var(--text);}
.fp-type{font-size:11px;color:var(--muted);}
.fp-dist{font-size:12px;color:var(--success);font-weight:700;}
</style>
</head>
<body>
<div class="container">

<!-- ══════ HOME PAGE ══════ -->
<div id="homePage">
  <nav style="display:flex;justify-content:space-between;align-items:center;padding:14px 0 18px;flex-wrap:wrap;gap:10px;">
    <div style="font-family:'Baloo 2';font-size:1.8rem;font-weight:800;color:var(--primary);">✈️ TripAI</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="#loginBox" style="padding:8px 18px;border-radius:10px;background:var(--primary);color:#fff;font-weight:700;font-size:13px;text-decoration:none;">Login</a>
      <a href="#loginBox" style="padding:8px 18px;border-radius:10px;border:1.5px solid var(--primary);color:var(--primary);font-weight:700;font-size:13px;text-decoration:none;">Sign Up</a>
    </div>
  </nav>

  <div style="background:linear-gradient(135deg,#0f2460,#1a56db,#8b5cf6);border-radius:24px;padding:40px 32px;text-align:center;margin-bottom:28px;position:relative;overflow:hidden;">
